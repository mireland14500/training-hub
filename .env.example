# Password you type to log in to the app (single-user app)
APP_PASSWORD=change-me
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Public URL of the app (http://localhost:3000 locally, your Vercel URL in production)
APP_URL=http://localhost:3000

# Supabase -> Project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Strava -> https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; used when registering the Strava webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Anthropic API key, used to read SkiErg monitor photos
ANTHROPIC_API_KEY=

# Your time zone, so sessions land on the right day (e.g. Europe/London)
APP_TIMEZONE=UTC
